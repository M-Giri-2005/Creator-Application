			validation_All1 as "validation All"
			{
				type =  form
				form = Membership_Details
				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Total_Book_Count == 0 || input.Membership_Price == 0 || input.Books_Take_Available_Days == 0)
										{
											alert "Not Valid";
											cancel submit;
										}
						)
					}
				}

			}
			validation_All2 as "validation All"
			{
				type =  form
				form = Books_Inventory
				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Books_Qty == 0 || input.Book_Price == 0)
										{
											alert "Not Value In this Data Book Qty And Book Price Is Zero Value";
											cancel submit;
										}
						)
					}
				}

			}
			Delete_The_Row as "Delete The Row"
			{
				type =  form
				form = Books_Issue
				record event = on add or edit

				on delete row of Books_Details
				{
					actions 
					{
						custom deluge script
						(
											input.Total_Issue_Books = input.Total_Issue_Books - 1;
										input.Book_Count_Issue = input.Book_Count_Issue - 1;
										fetchAllProduct = Books_Inventory[Books_Department_Name == row.Books_Department].ID.getAll();
										for each  rec in input.Books_Details
										{
											var = rec.Books_ID;
											if(rec.Books_Department == row.Books_Department)
											{
												getSelectedProduct = input.Books_Details.Books_ID.getall();
												fetchAllProduct.removeAll(getSelectedProduct);
												fetchAllProduct.add(row.Books_ID);
												rec.Books_ID:ui.add(fetchAllProduct);
												rec.Books_ID=var;
											}
										}
										if(input.Total_Issue_Books == 0)
										{
											input.Sub_Count = 1;
											enable Total_Issue_Books;
										}
						)
					}
				}

			}
			validation_All3 as "validation All"
			{
				type =  form
				form = Membership_Type
				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Membership_Price == 0 || input.Total_Book_Count == 0 || input.Books_Take_Available_Days == 0 || input.Member_ID == 0 || input.Membership_Validity == 0)
										{
											alert "Not Valid You Enter The Zero Value Pls Enter The Great Than 0 ";
											cancel submit;
										}
						)
					}
				}

			}
			Hide_And_Disable5 as "Hide And Disable"
			{
				type =  form
				form = Membership_Extended
				record event = on add

				field rules
				{
					actions 
					{
						disable Discount,Member_Email,Member_ID,Member_Name,Membership_End_Date,Member_Phone,Membership_Issue_Date,Membership_Price,Membership_Status,Membership_Type,Recommended_Count,Total_Price;
					}
					actions 
					{
						hide Discount,Total_Price,Recommended_Count;
					}
				}

			}
			Change_Membership_end_dat as "Change Membership end date"
			{
				type =  form
				form = Membership_Extended
				button = Submit
				on click
				{
					actions 
					{
					on click
					(
						var = Membership_Details[Member_ID == input.Member_ID];
										var.Membership_Status="Active";
										var.Membership_Issue_Date=zoho.currentdate;
										var.Membership_End_Date=input.Membership_End_Date;
										openUrl("#Script:page.parent.refresh","same window");
					)
					}
				}
			}
			Hide_And_Disable6 as "Hide And Disable"
			{
				type =  form
				form = Books_Return
				record event = on add or edit

				field rules
				{
					actions 
					{
					hide add row of Books_Return_Details;
					}
				}

			}
			UI_add as "UI.add"
			{
				type =  form
				form = Books_Issue
				record event = on add or edit

				on add row of Books_Details
				{
					actions 
					{
						custom deluge script
						(
											fetchh = Books_Inventory[Books_Department_Name == row.Books_Department].ID.getAll();
										if(row.Books_Department == null)
										{
											row.Books_ID:ui.add(fetchh);
										}
						)
					}
				}

			}
		}

		schedule
		{
			Change_Status as "Change Status"
			{
				type =  schedule
				start = "2025-12-30 23:59:59"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						var = Membership_Details[ID != null];
										for each  rec in var
										{
											if(rec.Membership_End_Date < zoho.currentdate)
											{
												rec.Membership_Status="Expiry";
											}
										}
					)
					}
				}
			}
		}




		functions
		{
			Extended_Membership as "Extended Membership"
			{
				type =  functions
				form = Membership_Details
				execution type = for each record	
				on start
				{
					actions 
					{
					on click
					(
						openUrl("#Form:Membership_Extended?Member_ID=" + input.Member_ID + "&Member_Name.first_name=" + input.Member_Name.first_name + "&Member_Name.last_name=" + input.Member_Name.last_name + "&Member_Email=" + input.Member_Email + "&Member_Phone=" + input.Member_Phone + "&Membership_Type=" + input.Membership_Type + "&Membership_Price=" + input.Membership_Price + "&Membership_End_Date=" + zoho.currentdate.addDay(input.Membership_Type.Membership_Validity),"popup window","height=<height>,width=<width>");
					)
					}
				}
			}
		}
	}
