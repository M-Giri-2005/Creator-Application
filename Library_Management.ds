    			type = date
				displayname = "Membership Issue Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Membership_End_Date
			(
    			type = date
				displayname = "Membership End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Member_ID
			(
    			type = text
				displayname = "Member ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Recommendation_ID
			(
				type = picklist	
				displayname = "Recommendation ID"
				values  = Membership_Details.ID
    			displayformat = [Member_ID + " - " + Member_Name.first_name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Recommended_Count
			(
				type = number
				displayname = "Recommended Count"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Membership_Status
			(
				type = picklist
				displayname = "Membership Status"
				maxchar = 100
				values = {"Active","Expiry"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Membership_Extended
		{
			displayname = "Membership Extended"
			store data in zc = false
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Member_ID
			(
    			type = text
				displayname = "Member ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Member_Name
			(
    			type = name
				displayname = "Member Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Member_Email
			(
    			type = email
				displayname = "Member Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Member_Phone
			(
    			type = phonenumber
				displayname = "Member Phone"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Membership_Type
			(
				type = picklist	
				displayname = "Membership Type"
				values  = Membership_Type.ID
    			displayformat = [Member_Type]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Membership_Price
			(
				displayname = "Membership Price"
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Recommended_Count
			(
				type = number
				displayname = "Recommended Count"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Discount
			(
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Price
			(
				displayname = "Total Price"
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Membership_Issue_Date
			(
    			type = date
				displayname = "Membership Issue Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Membership_End_Date
			(
    			type = date
				displayname = "Membership End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Membership_Status
			(
				type = picklist
				displayname = "Membership Status"
				maxchar = 100
				values = {"Active","Expiry"}
				initial value = "Active"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				Submit
				(
   					type = submit
   					displayname = "Submit"
				)
			}
		}
		form Membership_Type
		{
			displayname = "Membership Type"
			success message = "Membership Type Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Member_Type
			(
    			type = text
				displayname = "Member Type"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Member_ID
			(
				type = number
				displayname = "Member ID"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Membership_Price
			(
				displayname = "Membership Price"
				type = INR
				format = commadotindian
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Total_Book_Count
			(
				type = number
				displayname = "Total Book Count"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Membership_Validity
			(
				type = number
				displayname = "Membership Validity"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Books_Take_Available_Days
			(
				type = number
				displayname = "Books Take Available Days"
				initial value = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Membership_Details
		{
			displayName = "All Membership Details"
			show all rows from Membership_Details    
			(
				Member_Name  as "Member Name"
	 			(
	      			displayformat = [first_name+""+prefix+""+last_name+""+suffix]
	 			)
				Member_Email as "Member Email"
				Member_Phone as "Member Phone"
				(
					displayformat = plainnumber 
					linktodial = enable
				)
				Member_Address  as "Member Address"
	 			(
	      			displayformat = [address_line_1+""+address_line_2+""+district_city+""+state_province+""+postal_Code+""+country]
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Total_Book_Count as "Total Book Count"
				Prv_Take_Book as "Prv Take Book"
				Membership_Price as "Membership Price"
				Membership_Issue_Date as "Membership Issue Date"
				Membership_End_Date as "Membership End Date"
				Member_ID as "Member ID"
				Membership_Type as "Membership Type"
				Books_Take_Available_Days as "Books Take Available Days"
