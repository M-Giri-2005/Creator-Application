			)
			must have Total_Issue_Books
			(
				type = number
				displayname = "Total Issue Books"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Book_Count_Issue
			(
				type = number
				displayname = "Book Count Issue"
				initial value = 0
