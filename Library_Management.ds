 application "Library Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"
 	forms
	{
		form Books_Department
		{
			displayname = "Books Department"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Department_Name
			(
    			type = text
				displayname = "Department Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Books_Inventory
		{
			displayname = "Books Inventory"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Books_Department_Name
			(
				type = picklist	
				displayname = "Books Department Name"
				values  = Books_Department.ID
    			displayformat = [Department_Name]
				allow new entries
				[
					displayname = "Add New Department"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Book_Name
			(
    			type = text
				displayname = "Book Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Book_Author
			(
    			type = text
				displayname = "Book Author"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Books_Qty
			(
				type = number
				displayname = "Books Qty"
				initial value = 0
