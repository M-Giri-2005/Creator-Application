				custom action "Extended Membership "
				(
	  			workflow = Extended_Membership
				show action in edit record menu = true
				column header = "Extended Membership "
				condition = (Membership_Status == "Expiry")
				confirmation before execution
				(
					message for individual record = "&#x1f4da;⏳ Has the library membership been extended?"
