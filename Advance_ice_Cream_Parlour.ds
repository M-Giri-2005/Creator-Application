 application "Advance ice Cream Parlour"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"
 	forms
	{
		form Ice_Cream_Details
		{
			displayname = "Ice Cream Details"
			success message = "Ice Cream Detail Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Ice_Cream_Flavors
			(
    			type = text
				displayname = "Ice Cream Flavors "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Ice_Cream_Price
			(
				displayname = "Ice Cream Price"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Ice_Toppings_Details
		{
			displayname = "Ice Toppings Details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Ice_Toppings
			(
    			type = text
				displayname = "Ice Toppings "
	 			row = 1
	 			column = 1   
				width = medium
			)
			Ice_Toppings_Price
			(
				displayname = "Ice Toppings Price"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Order
		{
			success message = "Order Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Order_ID
			(
    			type = text
				displayname = "Order ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			Customer_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Customer_Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Customer_Phone
			(
    			type = phonenumber
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Customer_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Order_Details
			(
				type = grid
				displayname = "Order Details"
				Ice_Cream_Flavors
				(
					type = picklist	
					displayname = "Ice Cream Flavors "
					values  = Ice_Cream_Details.ID
    				displayformat = [Ice_Cream_Flavors]
					sortorder = ascending
					width = medium
				)
				Ice_Cream_Price
				(
					displayname = "Ice Cream Price"
					type = INR
					format = commadotindian
					initial value = 0
					width = medium
				)
				Ice_Toppings
				(
					type = list	
					displayname = "Ice Toppings"
					values  = Ice_Toppings_Details.ID
    				displayformat = [Ice_Toppings + " - " + Ice_Toppings_Price]
					sortorder = ascending
					height = 60px
					width = medium
				)
				Ice_Toppings_Price
				(
					displayname = "Ice Toppings Price"
					type = INR
					format = commadotindian
					initial value = 0
					width = medium
				)
				Ice_Cream_Total_Price
				(
					displayname = "Ice Cream Total Price "
					type = INR
					format = commadotindian
					initial value = 0
					width = medium
				)
				Order_Status
				(
					type = picklist
					displayname = "Order Status"
					maxchar = 100
					values = {"accept","cancel","prosses"}
					initial value = "prosses"
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Checkbox
			(
				type = checkboxes	
				values = {"I have one more request"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Personalization
			(
				type = picklist	
				values  = Personalization.ID
    			displayformat = [Personalization]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Personalization_Price
			(
				displayname = "Personalization Price"
				type = INR
				format = commadotindian
	 			row = 3
	 			column = 1   
				width = medium
			)
			Grand_Total
			(
				displayname = "Grand Total"
				type = INR
				format = commadotindian
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Personalization
		{
			success message = "Personation Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Personalization
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Price
			(
				type = INR
				format = commadotindian
	 			row = 1
